# Copy to deploy/.env and replace every replace-me value before startup.
# Passwords are embedded in PostgreSQL URLs; generate URL-safe values.

WINDMILL_DB_USER=windmill_app
WINDMILL_DB_PASSWORD=replace-me-with-a-unique-windmill-password
WINDMILL_DB_NAME=windmill

CAMPAIGN_DB_USER=campaign_owner
CAMPAIGN_DB_PASSWORD=replace-me-with-a-different-campaign-password
CAMPAIGN_DB_NAME=campaign
CAMPAIGN_ENVIRONMENT=development
# Comma-separated browser origins allowed to call Campaign Core; keep empty when a same-origin proxy is used.
CAMPAIGN_CORS_ORIGINS=

# Development binds the only host port to loopback.
WINDMILL_BIND_ADDRESS=127.0.0.1
WINDMILL_HTTP_PORT=8000

# Configure the live or snapshot Starfall root outside domain logic.
# This mount is declared read-only and is used only by the source-check profile.
# Docker Desktop rejects UNC bind sources; use a Docker-bindable local snapshot
# for Windows checks or the native /mnt dataset path on TrueNAS.
LEGACY_SOURCE_PATH=replace-me-with-read-only-starfall-path

# TrueNAS override: create these datasets before deployment.
WINDMILL_DB_DATASET=/mnt/replace-me/dm-assistant/postgres-windmill
CAMPAIGN_DB_DATASET=/mnt/replace-me/dm-assistant/postgres-campaign
WINDMILL_CACHE_DATASET=/mnt/replace-me/dm-assistant/windmill-cache
WINDMILL_LOG_DATASET=/mnt/replace-me/dm-assistant/windmill-logs
BACKUP_DATASET=/mnt/replace-me/dm-assistant/backups
